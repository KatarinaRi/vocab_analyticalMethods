cenvo:ICICPMS a skos:Concept ;
    skos:altLabel "IC-ICP-MS"@en ;
    skos:broader cenvo:MixICP ;
    skos:definition "Ion Chromatography – ICP Mass Spectrometry — for ionic element species."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICICPMS" ;
    skos:prefLabel "ICICPMS"@en .

cenvo:ICMSMSt a skos:Concept ;
    skos:altLabel "IC-MS/MS"@en ;
    skos:broader cenvo:ICMS ;
    skos:definition "Ion Chromatography – Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICMSMSt" ;
    skos:prefLabel "ICMSMSt"@en .

cenvo:ICPAES a skos:Concept ;
    skos:altLabel "ICP Atomic Emission Spectroscopy"@en,
        "ICP-AES"@en ;
    skos:broader cenvo:ICP ;
    skos:definition "ICP Atomic Emission Spectroscopy — measures atomic emission from an ICP source. NOTE: widely considered a synonym of ICP-OES — to be verified against PARC D9.4-1. ICP-AES acronym may conflict with Auger Electron Spectroscopy."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICPAES" ;
    skos:prefLabel "ICPAES"@en ;
    skos:scopeNote "ICP-AES and ICP-OES are widely considered synonyms. ICP-OES is preferred as unambiguous. ICP-AES acronym may conflict with Auger Electron Spectroscopy. Status to be verified against PARC D9.4-1."@en .

cenvo:ICPDRCMS a skos:Concept ;
    skos:altLabel "ICP Dynamic Reaction Cell MS"@en,
        "ICP-DRC-MS"@en ;
    skos:broader cenvo:ICPMS ;
    skos:definition "ICP Dynamic Reaction Cell Mass Spectrometry — uses a reaction cell filled with a reactive gas to eliminate spectral interferences."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICPDRCMS" ;
    skos:prefLabel "ICPDRCMS"@en .

cenvo:ICPKEDMS a skos:Concept ;
    skos:altLabel "ICP Kinetic Energy Discrimination MS"@en,
        "ICP-KED-MS"@en ;
    skos:broader cenvo:ICPMS ;
    skos:definition "ICP Kinetic Energy Discrimination Mass Spectrometry — uses a collision cell with kinetic energy discrimination to reduce polyatomic interferences."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICPKEDMS" ;
    skos:prefLabel "ICPKEDMS"@en .

cenvo:ICPMSMS a skos:Concept ;
    skos:altLabel "ICP Tandem Mass Spectrometry"@en,
        "ICP-MS/MS"@en ;
    skos:broader cenvo:ICPMS ;
    skos:definition "ICP Tandem Mass Spectrometry — uses two mass analysers in series to reduce spectral interferences."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICPMSMS" ;
    skos:prefLabel "ICPMSMS"@en .

cenvo:ICPOES a skos:Concept ;
    skos:altLabel "ICP Optical Emission Spectroscopy"@en,
        "ICP-OES"@en ;
    skos:broader cenvo:ICP ;
    skos:definition "ICP Optical Emission Spectroscopy — measures optical emission from an ICP source. NOTE: widely considered a synonym of ICP-AES — to be verified against PARC D9.4-1. ICP-OES is the preferred unambiguous acronym."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICPOES" ;
    skos:prefLabel "ICPOES"@en ;
    skos:scopeNote "ICP-OES is the preferred unambiguous acronym. ICP-AES and ICP-OES are widely considered synonyms. Status to be verified against PARC D9.4-1."@en .

cenvo:ICUV a skos:Concept ;
    skos:altLabel "IC-UV"@en ;
    skos:broader cenvo:IC ;
    skos:definition "Ion Chromatography – Ultraviolet Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "ICUV" ;
    skos:prefLabel "ICUV"@en .

