<https://w3id.org/chemical-exposome/vocabulary/analytical-methods> a owl:Ontology ;
    dct:created "2026-07-30T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0003-0222-801x> ;
    dct:description "Controlled vocabulary of analytical methods used for chemical analysis in environmental monitoring samples. Covers spectroscopy, mass spectrometry, chromatography, mixed methods and other analytical techniques. Developed within the PARC (Partnership for the Assessment of Risks from Chemicals) project, aligned with PARC deliverable D9.4-1."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-07-30T00:00:00+00:00"^^xsd:dateTime ;
    dct:title "Analytical Methods Vocabulary"@en ;
    owl:versionInfo "2.1.0" .

cenvo:AdvancedMercuryAnalyzer a skos:Concept ;
    skos:altLabel "AMA"@en ;
    skos:broader cenvo:AAS ;
    skos:definition "Advanced Mercury Analyzer — instrument dedicated to mercury determination using thermal decomposition and atomic absorption."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "AdvancedMercuryAnalyzer" ;
    skos:prefLabel "AdvancedMercuryAnalyzer"@en .

cenvo:C13NMR a skos:Concept ;
    skos:altLabel "13C NMR"@en,
        "Carbon-13 NMR"@en ;
    skos:broader cenvo:NMR ;
    skos:definition "Carbon-13 Nuclear Magnetic Resonance Spectroscopy — measures the NMR signal from carbon-13 nuclei."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "C13NMR" ;
    skos:prefLabel "C13NMR"@en .

cenvo:CVAAS a skos:Concept ;
    skos:altLabel "CV-AAS"@en,
        "Cold Vapour AAS"@en ;
    skos:broader cenvo:AAS ;
    skos:definition "Cold Vapour Atomic Absorption Spectroscopy — used for mercury determination; mercury vapour is generated and swept into the light path for measurement."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "CVAAS" ;
    skos:prefLabel "CVAAS"@en ;
    skos:scopeNote "Included in PARC deliverable D9.4-1"@en .

cenvo:CVAFS a skos:Concept ;
    skos:altLabel "CV-AFS"@en,
        "Cold Vapour AFS"@en ;
    skos:broader cenvo:AFS ;
    skos:definition "Cold Vapour Atomic Fluorescence Spectroscopy — used for mercury determination; mercury vapour is generated and measured by fluorescence."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "CVAFS" ;
    skos:prefLabel "CVAFS"@en .

cenvo:CZE a skos:Concept ;
    skos:altLabel "Capillary Electrophoresis"@en,
        "Capillary Zone Electrophoresis"@en ;
    skos:broader cenvo:Electrophoresis ;
    skos:definition "Capillary Zone Electrophoresis — electrophoretic separation in a narrow capillary using an electric field."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "CZE" ;
    skos:prefLabel "CZE"@en ;
    skos:scopeNote "Included in PARC deliverable D9.4-1"@en .

cenvo:Colorimetry a skos:Concept ;
    skos:altLabel "Colorimetric methods"@en ;
    skos:broader cenvo:Spectrophotometry ;
    skos:definition "Colorimetry — measurement of colour or light absorption in the visible range, often after a colour-forming reaction."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "Colorimetry" ;
    skos:prefLabel "Colorimetry"@en ;
    skos:scopeNote "Included in PARC deliverable D9.4-1"@en .

cenvo:DADUVVis a skos:Concept ;
    skos:altLabel "DAD UV-Vis"@en,
        "Diode Array Detection UV-Vis"@en ;
    skos:broader cenvo:UVVis ;
    skos:definition "Multi-Wavelength UV-Visible Spectroscopy with Diode Array Detection — simultaneous measurement across a range of wavelengths using a diode array detector."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "DADUVVis" ;
    skos:prefLabel "DADUVVis"@en .

cenvo:DirectAAS a skos:Concept ;
    skos:altLabel "Direct AAS"@en ;
    skos:broader cenvo:AAS ;
    skos:definition "Direct Atomic Absorption Spectroscopy — direct measurement without prior separation or generation steps."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "DirectAAS" ;
    skos:prefLabel "DirectAAS"@en .

cenvo:DirectAES a skos:Concept ;
    skos:altLabel "Direct AES"@en ;
    skos:broader cenvo:AES ;
    skos:definition "Direct Atomic Emission Spectroscopy — direct measurement without prior separation or generation steps."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "DirectAES" ;
    skos:prefLabel "DirectAES"@en .

cenvo:DirectAFS a skos:Concept ;
    skos:altLabel "Direct AFS"@en ;
    skos:broader cenvo:AFS ;
    skos:definition "Direct Atomic Fluorescence Spectroscopy — direct measurement without prior separation or generation steps."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "DirectAFS" ;
    skos:prefLabel "DirectAFS"@en .

cenvo:DirectMercuryAnalyzer a skos:Concept ;
    skos:altLabel "DMA"@en ;
    skos:broader cenvo:AAS ;
    skos:definition "Direct Mercury Analyzer — instrument for direct mercury determination in solid and liquid samples without prior digestion."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "DirectMercuryAnalyzer" ;
    skos:prefLabel "DirectMercuryAnalyzer"@en .

cenvo:EDXRF a skos:Concept ;
    skos:altLabel "ED-XRF"@en,
        "Energy-Dispersive XRF"@en ;
    skos:broader cenvo:XRF ;
    skos:definition "Energy-Dispersive X-ray Fluorescence Spectroscopy — separates fluorescent X-rays by energy using a semiconductor detector."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "EDXRF" ;
    skos:prefLabel "EDXRF"@en .

cenvo:FIAFS a skos:Concept ;
    skos:altLabel "FI-AFS"@en,
        "Flow Injection AFS"@en ;
    skos:broader cenvo:AFS ;
    skos:definition "Flow Injection Atomic Fluorescence Spectroscopy — flow injection analysis coupled with atomic fluorescence spectroscopy."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "FIAFS" ;
    skos:prefLabel "FIAFS"@en .

cenvo:FlameAAS a skos:Concept ;
    skos:altLabel "FAAS"@en,
        "Flame AAS"@en ;
    skos:broader cenvo:AAS ;
    skos:definition "Flame Atomic Absorption Spectroscopy — sample is aspirated into a flame to produce free atoms for measurement."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "FlameAAS" ;
    skos:prefLabel "FlameAAS"@en .

cenvo:FlameAES a skos:Concept ;
    skos:altLabel "Flame AES"@en ;
    skos:broader cenvo:AES ;
    skos:definition "Flame Atomic Emission Spectroscopy — uses a flame to excite atoms which then emit characteristic radiation."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "FlameAES" ;
    skos:prefLabel "FlameAES"@en .

