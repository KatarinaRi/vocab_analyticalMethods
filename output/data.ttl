    skos:broader cenvo:LC ;
    skos:definition "Liquid Chromatography – Fluorescence Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCFLD" ;
    skos:prefLabel "LCFLD"@en .

