    skos:broader cenvo:LC ;
    skos:definition "Liquid Chromatography – Diode Array Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCDAD" ;
    skos:prefLabel "LCDAD"@en .

