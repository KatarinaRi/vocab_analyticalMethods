vocab:AnalyticalMethod a skos:ConceptScheme ;
    skos:definition "Controlled vocabulary of analytical methods used for chemical analysis in environmental monitoring samples. Full vocabulary published at https://w3id.org/chemical-exposome/vocabulary/analytical-methods"@en ;
