    skos:altLabel "LC-HRMS/MS"@en ;
    skos:broader cenvo:LCMS ;
    skos:definition "Liquid Chromatography – High Resolution Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCHRMSMSt" ;
    skos:prefLabel "LCHRMSMSt"@en .

cenvo:LCICPMS a skos:Concept ;
    skos:altLabel "LC-ICP-MS"@en ;
    skos:broader cenvo:MixICP ;
    skos:definition "Liquid Chromatography – ICP Mass Spectrometry — for element speciation in liquid samples."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCICPMS" ;
    skos:prefLabel "LCICPMS"@en .

cenvo:LCICPMSMSt a skos:Concept ;
    skos:altLabel "LC-ICP-MS/MS"@en ;
    skos:broader cenvo:MixICP ;
    skos:definition "Liquid Chromatography – ICP Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCICPMSMSt" ;
    skos:prefLabel "LCICPMSMSt"@en .

cenvo:LCIR a skos:Concept ;
    skos:altLabel "LC-IR"@en ;
    skos:broader cenvo:MixOthers ;
    skos:definition "Liquid Chromatography – Infrared Spectroscopy."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCIR" ;
    skos:prefLabel "LCIR"@en .

cenvo:LCMSMSt a skos:Concept ;
    skos:altLabel "LC-MS/MS"@en ;
    skos:broader cenvo:LCMS ;
    skos:definition "Liquid Chromatography – Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCMSMSt" ;
    skos:prefLabel "LCMSMSt"@en .

cenvo:LCNMR a skos:Concept ;
    skos:altLabel "LC-NMR"@en ;
    skos:broader cenvo:MixOthers ;
    skos:definition "Liquid Chromatography – Nuclear Magnetic Resonance Spectroscopy."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCNMR" ;
    skos:prefLabel "LCNMR"@en .

cenvo:LCUV a skos:Concept ;
    skos:altLabel "LC-UV"@en ;
    skos:broader cenvo:LC ;
    skos:definition "Liquid Chromatography – Ultraviolet Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCUV" ;
    skos:prefLabel "LCUV"@en .

cenvo:LCVIS a skos:Concept ;
    skos:altLabel "LC-VIS"@en ;
    skos:broader cenvo:LC ;
    skos:definition "Liquid Chromatography – Visible Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "LCVIS" ;
    skos:prefLabel "LCVIS"@en ;
    skos:scopeNote "Included in PARC deliverable D9.4-1"@en .

cenvo:PlasmaAES a skos:Concept ;
    skos:altLabel "Plasma AES"@en ;
    skos:broader cenvo:AES ;
    skos:definition "Plasma Atomic Emission Spectroscopy — uses a plasma source to excite atoms for emission measurement."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "PlasmaAES" ;
    skos:prefLabel "PlasmaAES"@en .

cenvo:SFCHRMS a skos:Concept ;
    skos:altLabel "SFC-HRMS"@en ;
    skos:broader cenvo:SFCMS ;
    skos:definition "Supercritical Fluid Chromatography – High Resolution Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "SFCHRMS" ;
    skos:prefLabel "SFCHRMS"@en .

cenvo:SFCHRMSMSt a skos:Concept ;
    skos:altLabel "SFC-HRMS/MS"@en ;
    skos:broader cenvo:SFCMS ;
    skos:definition "Supercritical Fluid Chromatography – High Resolution Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "SFCHRMSMSt" ;
    skos:prefLabel "SFCHRMSMSt"@en .

cenvo:SFCMSMSt a skos:Concept ;
    skos:altLabel "SFC-MS/MS"@en ;
    skos:broader cenvo:SFCMS ;
    skos:definition "Supercritical Fluid Chromatography – Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "SFCMSMSt" ;
    skos:prefLabel "SFCMSMSt"@en .

cenvo:SingleWavelengthUVVis a skos:Concept ;
    skos:altLabel "Single Wavelength UV-Vis"@en ;
    skos:broader cenvo:UVVis ;
    skos:definition "Single Wavelength UV-Visible Spectroscopy — measurement at a single fixed wavelength."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "SingleWavelengthUVVis" ;
    skos:prefLabel "SingleWavelengthUVVis"@en .

cenvo:TDAAS a skos:Concept ;
    skos:altLabel "TD-AAS"@en,
        "Thermal Decomposition AAS"@en ;
    skos:broader cenvo:AAS ;
    skos:definition "Thermal Decomposition Atomic Absorption Spectroscopy — the sample is thermally decomposed before atomic absorption measurement."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "TDAAS" ;
    skos:prefLabel "TDAAS"@en .

cenvo:TXRF a skos:Concept ;
    skos:altLabel "Total Reflection XRF"@en ;
    skos:broader cenvo:XRF ;
    skos:definition "Total Reflection X-ray Fluorescence Spectroscopy — uses total external reflection geometry to reduce background and improve detection limits."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "TXRF" ;
    skos:prefLabel "TXRF"@en .

cenvo:UPLCDAD a skos:Concept ;
    skos:altLabel "UPLC-DAD"@en ;
    skos:broader cenvo:UPLC ;
    skos:definition "Ultra Performance Liquid Chromatography – Diode Array Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCDAD" ;
    skos:prefLabel "UPLCDAD"@en .

cenvo:UPLCFLD a skos:Concept ;
    skos:altLabel "UPLC-FLD"@en ;
    skos:broader cenvo:UPLC ;
    skos:definition "Ultra Performance Liquid Chromatography – Fluorescence Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCFLD" ;
    skos:prefLabel "UPLCFLD"@en .

cenvo:UPLCHRMS a skos:Concept ;
    skos:altLabel "UPLC-HRMS"@en ;
    skos:broader cenvo:LCMS ;
    skos:definition "Ultra Performance Liquid Chromatography – High Resolution Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCHRMS" ;
    skos:prefLabel "UPLCHRMS"@en .

cenvo:UPLCHRMSMSt a skos:Concept ;
    skos:altLabel "UPLC-HRMS/MS"@en ;
    skos:broader cenvo:LCMS ;
    skos:definition "Ultra Performance Liquid Chromatography – High Resolution Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCHRMSMSt" ;
    skos:prefLabel "UPLCHRMSMSt"@en .

cenvo:UPLCMS a skos:Concept ;
    skos:altLabel "UPLC-MS"@en ;
    skos:broader cenvo:LCMS ;
    skos:definition "Ultra Performance Liquid Chromatography – Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCMS" ;
    skos:prefLabel "UPLCMS"@en .

cenvo:UPLCMSMSt a skos:Concept ;
    skos:altLabel "UPLC-MS/MS"@en ;
    skos:broader cenvo:LCMS ;
    skos:definition "Ultra Performance Liquid Chromatography – Tandem Mass Spectrometry."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCMSMSt" ;
    skos:prefLabel "UPLCMSMSt"@en .

cenvo:UPLCUV a skos:Concept ;
    skos:altLabel "UPLC-UV"@en ;
    skos:broader cenvo:UPLC ;
    skos:definition "Ultra Performance Liquid Chromatography – Ultraviolet Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCUV" ;
    skos:prefLabel "UPLCUV"@en .

cenvo:UPLCVIS a skos:Concept ;
    skos:altLabel "UPLC-VIS"@en ;
    skos:broader cenvo:UPLC ;
    skos:definition "Ultra Performance Liquid Chromatography – Visible Detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "UPLCVIS" ;
    skos:prefLabel "UPLCVIS"@en ;
    skos:scopeNote "Included in PARC deliverable D9.4-1"@en .

cenvo:WDXRF a skos:Concept ;
    skos:altLabel "WD-XRF"@en,
        "Wavelength-Dispersive XRF"@en ;
    skos:broader cenvo:XRF ;
    skos:definition "Wavelength-Dispersive X-ray Fluorescence Spectroscopy — separates fluorescent X-rays by wavelength using a crystal diffractometer."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:notation "WDXRF" ;
    skos:prefLabel "WDXRF"@en .

cenvo:Electrophoresis a skos:Concept ;
    skos:altLabel "Electrophoretic methods"@en ;
    skos:broader cenvo:Other ;
    skos:definition "Electrophoresis — separation of charged particles in a fluid under the influence of an electric field."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:CZE ;
    skos:notation "Electrophoresis" ;
    skos:prefLabel "Electrophoresis"@en .

cenvo:Spectrophotometry a skos:Concept ;
    skos:altLabel "Spectrophotometric methods"@en ;
    skos:broader cenvo:Other ;
    skos:definition "Spectrophotometry — measurement of light absorption or transmission by a solution at specific wavelengths."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:Colorimetry ;
    skos:notation "Spectrophotometry" ;
    skos:prefLabel "Spectrophotometry"@en .

cenvo:ICP a skos:Concept ;
    skos:altLabel "Inductively Coupled Plasma Spectroscopy"@en ;
    skos:broader cenvo:Spectroscopy ;
    skos:definition "Inductively Coupled Plasma Spectroscopy — uses an inductively coupled plasma to atomise and excite or ionise the sample for elemental analysis."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:ICPAES,
        cenvo:ICPOES ;
    skos:notation "ICP" ;
    skos:prefLabel "ICP"@en .

cenvo:MixOthers a skos:Concept ;
    skos:altLabel "Mix-Others"@en ;
    skos:broader cenvo:MixedMethods ;
    skos:definition "Other hyphenated analytical methods not covered by the Mix-ICP category."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:LCIR,
        cenvo:LCNMR ;
    skos:notation "MixOthers" ;
    skos:prefLabel "MixOthers"@en .

cenvo:MixedMethods a skos:Concept ;
    skos:altLabel "Coupled methods"@en,
        "Hyphenated methods"@en ;
    skos:broader cenvo:AnalyticalMethod ;
    skos:definition "Analytical methods combining chromatographic separation with spectroscopic or mass spectrometric detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:MixICP,
        cenvo:MixOthers ;
    skos:notation "MixedMethods" ;
    skos:prefLabel "MixedMethods"@en .

cenvo:NMR a skos:Concept ;
    skos:altLabel "Nuclear Magnetic Resonance Spectroscopy"@en ;
    skos:broader cenvo:Spectroscopy ;
    skos:definition "Nuclear Magnetic Resonance Spectroscopy — uses the magnetic properties of atomic nuclei to determine molecular structure and composition."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:C13NMR,
        cenvo:H1NMR ;
    skos:notation "NMR" ;
    skos:prefLabel "NMR"@en .

cenvo:Other a skos:Concept ;
    skos:broader cenvo:AnalyticalMethod ;
    skos:definition "Analytical methods that do not fit within Spectroscopy, Mass Spectrometry, Chromatography, or Mixed Methods categories."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:Electrophoresis,
        cenvo:Spectrophotometry ;
    skos:notation "Other" ;
    skos:prefLabel "Other"@en .

cenvo:UVVis a skos:Concept ;
    skos:altLabel "UV-Vis"@en,
        "UV-Visible Spectroscopy"@en ;
    skos:broader cenvo:Spectroscopy ;
    skos:definition "UV-Visible Spectroscopy — measures absorption of ultraviolet and visible light by molecules in solution."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:DADUVVis,
        cenvo:SingleWavelengthUVVis ;
    skos:notation "UVVis" ;
    skos:prefLabel "UVVis"@en .

cenvo:Chromatography a skos:Concept ;
    skos:altLabel "Chromatographic methods"@en ;
    skos:broader cenvo:AnalyticalMethod ;
    skos:definition "Analytical methods based on the separation of chemical mixtures by differential migration through a stationary phase."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:GC,
        cenvo:IC,
        cenvo:LC ;
    skos:notation "Chromatography" ;
    skos:prefLabel "Chromatography"@en .

cenvo:IC a skos:Concept ;
    skos:altLabel "Ion Chromatography"@en ;
    skos:broader cenvo:Chromatography ;
    skos:definition "Ion Chromatography — separation technique for ions and polar molecules using ion exchange as the separation mechanism."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:ICDAD,
        cenvo:ICFLD,
        cenvo:ICUV ;
    skos:notation "IC" ;
    skos:prefLabel "IC"@en .

cenvo:ICPMS a skos:Concept ;
    skos:altLabel "ICP-MS"@en,
        "Inductively Coupled Plasma Mass Spectrometry"@en ;
    skos:broader cenvo:MassSpectrometry ;
    skos:definition "ICP Mass Spectrometry — uses an inductively coupled plasma to ionise the sample, with mass spectrometric detection for elemental and isotopic analysis."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:ICPDRCMS,
        cenvo:ICPKEDMS,
        cenvo:ICPMSMS ;
    skos:notation "ICPMS" ;
    skos:prefLabel "ICPMS"@en .

cenvo:SFCMS a skos:Concept ;
    skos:altLabel "SFC-MS"@en,
        "Supercritical Fluid Chromatography Mass Spectrometry"@en ;
    skos:broader cenvo:MassSpectrometry ;
    skos:definition "Supercritical Fluid Chromatography – Mass Spectrometry — uses supercritical fluid as the mobile phase with mass spectrometric detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:SFCHRMS,
        cenvo:SFCHRMSMSt,
        cenvo:SFCMSMSt ;
    skos:notation "SFCMS" ;
    skos:prefLabel "SFCMS"@en .

cenvo:XRF a skos:Concept ;
    skos:altLabel "X-ray Fluorescence Spectroscopy"@en ;
    skos:broader cenvo:Spectroscopy ;
    skos:definition "X-ray Fluorescence Spectroscopy — uses X-ray excitation to produce characteristic fluorescent X-rays from elements in the sample."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:EDXRF,
        cenvo:TXRF,
        cenvo:WDXRF ;
    skos:notation "XRF" ;
    skos:prefLabel "XRF"@en .

cenvo:AES a skos:Concept ;
    skos:altLabel "Atomic Emission Spectroscopy"@en ;
    skos:broader cenvo:Spectroscopy ;
    skos:definition "Atomic Emission Spectroscopy — a technique that uses the emission of light by excited atoms to identify and quantify elements."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:DirectAES,
        cenvo:FlameAES,
        cenvo:GDAES,
        cenvo:PlasmaAES ;
    skos:notation "AES" ;
    skos:prefLabel "AES"@en .

cenvo:AFS a skos:Concept ;
    skos:altLabel "Atomic Fluorescence Spectroscopy"@en ;
    skos:broader cenvo:Spectroscopy ;
    skos:definition "Atomic Fluorescence Spectroscopy — measures the fluorescence emitted by atoms excited by a light source; highly sensitive for trace element determination."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:CVAFS,
        cenvo:DirectAFS,
        cenvo:FIAFS,
        cenvo:HGAFS ;
    skos:notation "AFS" ;
    skos:prefLabel "AFS"@en .

cenvo:HPLC a skos:Concept ;
    skos:altLabel "High Performance Liquid Chromatography"@en,
        "High Pressure Liquid Chromatography"@en ;
    skos:broader cenvo:LC ;
    skos:definition "High Performance Liquid Chromatography — liquid chromatography using high pressure to force the mobile phase through a tightly packed stationary phase column."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:HPLCDAD,
        cenvo:HPLCFLD,
        cenvo:HPLCUV,
        cenvo:HPLCVIS ;
    skos:notation "HPLC" ;
    skos:prefLabel "HPLC"@en .

cenvo:MixICP a skos:Concept ;
    skos:altLabel "Chromatography-ICP-MS"@en,
        "Mix-ICP"@en ;
    skos:broader cenvo:MixedMethods ;
    skos:definition "Chromatography Coupled to ICP-MS — hyphenated methods combining chromatographic separation with ICP-MS detection for speciation analysis."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:GCICPMS,
        cenvo:ICICPMS,
        cenvo:LCICPMS,
        cenvo:LCICPMSMSt ;
    skos:notation "MixICP" ;
    skos:prefLabel "MixICP"@en .

cenvo:UPLC a skos:Concept ;
    skos:altLabel "UHPLC"@en,
        "Ultra Performance Liquid Chromatography"@en ;
    skos:broader cenvo:LC ;
    skos:definition "Ultra Performance Liquid Chromatography — liquid chromatography using sub-2-micron particle columns and very high pressures for improved resolution and speed."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:UPLCDAD,
        cenvo:UPLCFLD,
        cenvo:UPLCUV,
        cenvo:UPLCVIS ;
    skos:notation "UPLC" ;
    skos:prefLabel "UPLC"@en .

cenvo:AnalyticalMethod a skos:Concept ;
    skos:definition "Any method used for the chemical analysis of environmental samples. Top-level concept encompassing all analytical techniques."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:Chromatography,
        cenvo:MassSpectrometry,
        cenvo:MixedMethods,
        cenvo:Other,
        cenvo:Spectroscopy ;
    skos:notation "AnalyticalMethod" ;
    skos:prefLabel "AnalyticalMethod"@en ;
    skos:topConceptOf vocab:AnalyticalMethod .

cenvo:GC a skos:Concept ;
    skos:altLabel "Gas Chromatography"@en ;
    skos:broader cenvo:Chromatography ;
    skos:definition "Gas Chromatography — separation technique using a gaseous mobile phase; analytes must be volatile or derivatised to be volatile."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:GCECD,
        cenvo:GCFID,
        cenvo:GCFPD,
        cenvo:GCNPD,
        cenvo:GCPID ;
    skos:notation "GC" ;
    skos:prefLabel "GC"@en .

cenvo:MassSpectrometry a skos:Concept ;
    skos:altLabel "MS methods"@en ;
    skos:broader cenvo:AnalyticalMethod ;
    skos:definition "Analytical methods based on the measurement of mass-to-charge ratios of ions to identify and quantify chemical substances."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:GCMS,
        cenvo:ICMS,
        cenvo:ICPMS,
        cenvo:LCMS,
        cenvo:SFCMS ;
    skos:notation "MassSpectrometry" ;
    skos:prefLabel "MassSpectrometry"@en .

cenvo:LC a skos:Concept ;
    skos:altLabel "Liquid Chromatography"@en ;
    skos:broader cenvo:Chromatography ;
    skos:definition "Liquid Chromatography — separation technique using a liquid mobile phase passing through a stationary phase."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:HPLC,
        cenvo:LCDAD,
        cenvo:LCFLD,
        cenvo:LCUV,
        cenvo:LCVIS,
        cenvo:UPLC ;
    skos:notation "LC" ;
    skos:prefLabel "LC"@en .

cenvo:AAS a skos:Concept ;
    skos:altLabel "Atomic Absorption Spectroscopy"@en ;
    skos:broader cenvo:Spectroscopy ;
    skos:definition "Atomic Absorption Spectroscopy — a technique for measuring concentrations of elements by measuring the absorption of light by free atoms in the gaseous state."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:AdvancedMercuryAnalyzer,
        cenvo:CVAAS,
        cenvo:DirectAAS,
        cenvo:DirectMercuryAnalyzer,
        cenvo:FlameAAS,
        cenvo:GFAAS,
        cenvo:TDAAS ;
    skos:notation "AAS" ;
    skos:prefLabel "AAS"@en .

cenvo:ICMS a skos:Concept ;
    skos:altLabel "IC-MS"@en,
        "Ion Chromatography Mass Spectrometry"@en ;
    skos:broader cenvo:MassSpectrometry ;
    skos:definition "Ion Chromatography – Mass Spectrometry — combines ion chromatographic separation with mass spectrometric detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:ICESIHRMS,
        cenvo:ICESIHRMSMSt,
        cenvo:ICESIMS,
        cenvo:ICESIMSMSt,
        cenvo:ICHRMS,
        cenvo:ICHRMSMSt,
        cenvo:ICMSMSt ;
    skos:notation "ICMS" ;
    skos:prefLabel "ICMS"@en .

cenvo:Spectroscopy a skos:Concept ;
    skos:altLabel "Spectroscopic methods"@en ;
    skos:broader cenvo:AnalyticalMethod ;
    skos:definition "Analytical methods based on the interaction of matter with electromagnetic radiation to identify and quantify chemical substances."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:AAS,
        cenvo:AES,
        cenvo:AFS,
        cenvo:ICP,
        cenvo:NMR,
        cenvo:UVVis,
        cenvo:XRF ;
    skos:notation "Spectroscopy" ;
    skos:prefLabel "Spectroscopy"@en .

cenvo:LCMS a skos:Concept ;
    skos:altLabel "LC-MS"@en,
        "Liquid Chromatography Mass Spectrometry"@en ;
    skos:broader cenvo:MassSpectrometry ;
    skos:definition "Liquid Chromatography – Mass Spectrometry — combines liquid chromatographic separation with mass spectrometric detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:HPLCECD,
        cenvo:HPLCHRMS,
        cenvo:HPLCHRMSMSt,
        cenvo:HPLCMS,
        cenvo:HPLCMSMSt,
        cenvo:LCHRMS,
        cenvo:LCHRMSMSt,
        cenvo:LCMSMSt,
        cenvo:UPLCHRMS,
        cenvo:UPLCHRMSMSt,
        cenvo:UPLCMS,
        cenvo:UPLCMSMSt ;
    skos:notation "LCMS" ;
    skos:prefLabel "LCMS"@en .

cenvo:GCMS a skos:Concept ;
    skos:altLabel "GC-MS"@en,
        "Gas Chromatography Mass Spectrometry"@en ;
    skos:broader cenvo:MassSpectrometry ;
    skos:definition "Gas Chromatography – Mass Spectrometry — combines gas chromatographic separation with mass spectrometric detection."@en ;
    skos:inScheme vocab:AnalyticalMethod ;
    skos:narrower cenvo:GCAPCIHRMS,
        cenvo:GCAPCIHRMSMSt,
        cenvo:GCAPCIMS,
        cenvo:GCAPCIMSMSt,
        cenvo:GCAPPIHRMS,
        cenvo:GCAPPIHRMSMSt,
        cenvo:GCAPPIMS,
        cenvo:GCAPPIMSMSt,
        cenvo:GCCIHRMS,
        cenvo:GCCIHRMSMSt,
        cenvo:GCCIMS,
        cenvo:GCCIMSMSt,
        cenvo:GCEIHMS,
        cenvo:GCEIHRMSMSt,
        cenvo:GCEIMS,
        cenvo:GCEIMSMS,
        cenvo:GCHRMS,
        cenvo:GCHRMSMS,
        cenvo:GCMSMS,
        cenvo:GCNCIHRMS,
        cenvo:GCNCIHRMSMSt,
        cenvo:GCNCIMS,
        cenvo:GCNCIMSMSt,
        cenvo:GCxGCHRMS,
        cenvo:GCxGCMS,
        cenvo:GCxGCMSMSt ;
    skos:notation "GCMS" ;
    skos:prefLabel "GCMS"@en .

vocab:AnalyticalMethod a skos:ConceptScheme ;
    skos:definition "Controlled vocabulary of analytical methods used for chemical analysis in environmental monitoring samples. Full vocabulary published at https://w3id.org/chemical-exposome/vocabulary/analytical-methods"@en ;
    skos:hasTopConcept cenvo:AnalyticalMethod ;
    skos:prefLabel "AnalyticalMethod"@en .

