<https://w3id.org/chemical-exposome/vocabulary/analytical-methods> a owl:Ontology ;
    dct:created "2026-07-30T00:00:00+00:00"^^xsd:dateTime ;
    dct:creator <https://orcid.org/0000-0003-0222-801x> ;
    dct:description "Controlled vocabulary of analytical methods used for chemical analysis in environmental monitoring samples. Covers spectroscopy, mass spectrometry, chromatography, mixed methods and other analytical techniques. Developed within the PARC (Partnership for the Assessment of Risks from Chemicals) project, aligned with PARC deliverable D9.4-1."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-07-30T00:00:00+00:00"^^xsd:dateTime ;
    dct:title "Analytical Methods Vocabulary"@en ;
    owl:versionInfo "2.1.0" .

